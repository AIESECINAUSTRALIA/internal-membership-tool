# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
coverage/
dist/
dist-ssr/
.next/
out/
.cache/
.parcel-cache/
.vite/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

