# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
.envrc

# Credential material — never commit (public certs: use `git add -f`)
*.pem
*.key
*.p12
*-service-account.json

# ---------------------------------------------------------------------------
# Python backend
#
# Build-artifact dirs are ANCHORED to backend/ on purpose: unanchored names
# like lib/, var/, parts/, build/ would otherwise match anywhere and swallow
# real source dirs (e.g. frontend/src/lib/).
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/backend/build/
/backend/develop-eggs/
/backend/downloads/
/backend/eggs/
/backend/.eggs/
/backend/lib/
/backend/lib64/
/backend/parts/
/backend/sdist/
/backend/var/
/backend/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/

# Tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Postgres / database
# ---------------------------------------------------------------------------
*.sql.gz
*.dump
*.sqlite3
*.db
pgdata/
postgres-data/
docker-data/
*.pid

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml
compose.override.yml

# ---------------------------------------------------------------------------
