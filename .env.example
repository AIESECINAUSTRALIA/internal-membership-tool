# ---------------------------------------------------------------------------
# .env.example — template for the local .env file
# ---------------------------------------------------------------------------
# This file IS committed. It lists every variable the app reads, with safe
# placeholder values. It is the source of truth for WHAT configuration exists.
#
# The real file (.env) is git-ignored and NEVER committed. Create it with:
#
#     cp .env.example .env
#
# then fill in the real values (see docs/local-development.md → "Environment
# variables & secrets" for where those come from and how they're managed).
#
# When you add or rename a variable the code reads, update this file in the
# same commit.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# Consumed by docker compose: for ${...} substitution in docker-compose.yml
# and, via `env_file: .env`, injected into the `db` and `backend` containers.
# These are NOT secrets for local dev — the database is a throwaway container.
POSTGRES_USER=membership
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=membership

# Backend database connection.
# Host is `db` (the compose service name) when the backend runs in Docker.
# For native (non-Docker) backend dev, override the host to `localhost`.
DATABASE_URL=postgresql+psycopg://membership:localdevpassword@db:5432/membership

# Where the browser app runs (the Vite dev server locally). Allowed by CORS and the
# Origin check on writes, and where the browser lands after signing in. On a
# deployment it equals APP_BASE_URL (Firebase serves the app and /api together).
FRONTEND_ORIGIN=http://localhost:5173

# --- EXPA authentication (backend) -----------------------------------------
# OAuth application credentials are issued through the AIESEC developer portal.
# Use separate applications and credentials for development and production.
# Never commit actual client secrets.

EXPA_AUTH_URL=https://auth.aiesec.org
EXPA_GRAPHQL_URL=https://gis-api.aiesec.org/graphql
EXPA_CLIENT_ID=
EXPA_CLIENT_SECRET=

# Public origin serving the application and its /api routes.
# An https:// value also marks the session cookie Secure.
# The registered EXPA callback is:
# {APP_BASE_URL}/api/v1/auth/callback
APP_BASE_URL=http://localhost:8000

# Fixed authenticated session lifetime, in hours.
SESSION_TTL_HOURS=12

# Exact permitted email domains, comma-separated.
ALLOWED_EMAIL_DOMAINS=aiesec.net

# Temporary frontend settings retained until DEV-83 replaces Supabase.
# Do not configure these for the new EXPA backend authentication.
# --- Frontend --------------------------------------------------------------
# Only VITE_-prefixed vars are exposed to the browser by Vite. Do not put any
# server-side secret behind a VITE_ name.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=changeme

# How people sign in (docs/auth.md):
#   mock     — development sign-in button + mock personas, no Google, no backend
#   supabase — real "Sign in with Google", checked by the backend's GET /api/v1/me
# Unset: mock on the dev server, supabase in production builds. NEVER set mock in a
# deployed environment (Vercel Preview/Production) — spec §2A.3.
VITE_AUTH_MODE=mock
# Optional hint so Google's account picker shows only this domain's accounts. Only a
# hint: ALLOWED_EMAIL_DOMAINS (backend) is the real check.
VITE_GOOGLE_HOSTED_DOMAIN=aiesec.net
