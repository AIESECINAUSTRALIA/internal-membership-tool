# ---------------------------------------------------------------------------
# .env.example — template for the local .env file
# ---------------------------------------------------------------------------
# This file IS committed. It lists every variable the app reads, with safe
# placeholder values. It is the source of truth for WHAT configuration exists.
#
# The real file (.env) is git-ignored and NEVER committed. Create it with:
#
#     cp .env.example .env
#
# then fill in the real values (see docs/local-development.md → "Environment
# variables & secrets" for where those come from and how they're managed).
#
# When you add or rename a variable the code reads, update this file in the
# same commit.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# Consumed by docker compose: for ${...} substitution in docker-compose.yml
# and, via `env_file: .env`, injected into the `db` and `backend` containers.
# These are NOT secrets for local dev — the database is a throwaway container.
POSTGRES_USER=membership
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=membership

# Backend database connection.
# Host is `db` (the compose service name) when the backend runs in Docker.
# For native (non-Docker) backend dev, override the host to `localhost`.
DATABASE_URL=postgresql+psycopg://membership:localdevpassword@db:5432/membership

# CORS: the browser origin the API accepts requests from (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase (auth only) ----------------------------------------------------
# Real values — get them from the shared Bitwarden collection, not from Slack.
# From the Supabase project: Project Settings → API / API Keys.
#
# The project signs JWTs asymmetrically (ES256). There is no shared JWT secret:
# the backend verifies access tokens against the JWKS endpoint derived from
# SUPABASE_URL — <SUPABASE_URL>/auth/v1/.well-known/jwks.json — so SUPABASE_URL
# is the only Supabase value the backend needs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=changeme          # publishable key (sb_publishable_… or the legacy anon eyJ… key); browser-safe

# --- Frontend --------------------------------------------------------------
# Only VITE_-prefixed vars are exposed to the browser by Vite. Do not put any
# server-side secret behind a VITE_ name.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=changeme
